{
  "name": "simplecell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SimpleCell \u2014 a toy cellular world: continuous space, discrete time, symmetric chemistry.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "golden": "vite-node scripts/golden.ts",
    "profile": "vite-node scripts/profile.ts",
    "baseline": "vite-node scripts/baseline-stats.ts",
    "experiment": "vite-node scripts/experiment.ts",
    "ceiling": "vite-node scripts/ceiling.ts",
    "archipelago": "vite-node scripts/archipelago.ts",
    "economy": "vite-node scripts/economy.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
